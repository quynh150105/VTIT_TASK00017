server.port=8080

# Datasource for running the app locally while MySQL runs from docker-compose.yml.
# docker-compose exposes MySQL on host port 3307.
DB_URL=jdbc:mysql://localhost:3307/task00017?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=task00017
DB_PASSWORD=task00017

# Use a different strong secret outside local development.
JWT_SECRET=change-this-secret-key-32-chars-minimum
JWT_EXPIRATION_MINUTES=120

# Local mail testing with MailHog from docker-compose.yml.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
